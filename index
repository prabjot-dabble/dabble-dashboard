/* ==========================================================================
   TAB 6 — DAILY & WEEKLY
   ========================================================================== */
function renderDaily(){
  const dayTot = r => r.metaSp+r.amzSp+r.bikSp+(r.blkSp||0)+r.googSp;
  const E = {
    tot:extremes(rows.map(r=>r.tAct)), web:extremes(rows.map(r=>r.dAct)), amz:extremes(rows.map(r=>r.amzTot)),
    blk:extremes(rows.map(r=>r.blkGmv)), fc:extremes(rows.map(r=>r.fcGmv)), bik:extremes(rows.map(r=>r.bikGmv)),
    meta:extremes(rows.map(r=>r.metaSp)), amzS:extremes(rows.map(r=>r.amzSp)), bikS:extremes(rows.map(r=>r.bikSp)),
    sp:extremes(rows.map(dayTot)), ro:extremes(rows.map(r=>r.tAct/dayTot(r))),
    cv:extremes(rows.map(r=>r.orders/r.traff)), av:extremes(rows.map(r=>r.dAct/r.orders))
  };
  const best = E.tot.hi, worst = E.tot.lo;
  document.getElementById("tDaily").innerHTML = tbl(
    ["Date","Total GMV","Website","Amazon","BlinkIT","FirstCry","BIK","Meta spend","Amazon spend","BIK spend","Recorded spend","Blended ROAS","Web conversion","Web AOV"],
    rows.map((r,i)=>{
      const cls = i===best ? " class='dayrow-best'" : (i===worst ? " class='dayrow-worst'" : "");
      return "<tr"+cls+"><td>"+r.lbl+" · "+r.dow+"</td>"+
        hcell(r.tAct,i,E.tot,v=>moneyFull(v))+
        hcell(r.dAct,i,E.web,v=>moneyFull(v))+
        hcell(r.amzTot,i,E.amz,v=>moneyFull(v))+
        hcell(r.blkGmv,i,E.blk,v=>moneyFull(v))+
        hcell(r.fcGmv,i,E.fc,v=>moneyFull(v))+
        hcell(r.bikGmv,i,E.bik,v=>moneyFull(v))+
        hcell(r.metaSp,i,E.meta,v=>moneyFull(v),true)+
        hcell(r.amzSp,i,E.amzS,v=>moneyFull(v),true)+
        hcell(r.bikSp,i,E.bikS,v=>moneyFull(v),true)+
        hcell(dayTot(r),i,E.sp,v=>moneyFull(v),true)+
        hcell(r.tAct/dayTot(r),i,E.ro,v=>rx(v))+
        hcell(r.orders/r.traff,i,E.cv,v=>pct(v,2))+
        hcell(r.dAct/r.orders,i,E.av,v=>moneyFull(v))+"</tr>";
    }).join(""),
    "<tr><td>Total</td><td>"+moneyFull(A.tAct)+"</td><td>"+moneyFull(A.dAct)+"</td><td>"+moneyFull(A.amzTot)+"</td><td>"+moneyFull(A.blkGmv)+"</td><td>"+moneyFull(A.fcGmv)+"</td><td>"+moneyFull(A.bikGmv)+"</td><td>"+moneyFull(A.metaSp)+"</td><td>"+moneyFull(A.amzSp)+"</td><td>"+moneyFull(A.bikSp)+"</td><td>"+moneyFull(A.spend)+"</td><td>"+rx(A.blendRoas)+"</td><td>"+pct(A.conv,2)+"</td><td>"+moneyFull(A.aov)+"</td></tr>");

  // growth
  const g = rows.map((r,i)=> i===0 ? null : (r.tAct-rows[i-1].tAct)/rows[i-1].tAct*100);
  mk("cGrowth", {type:"bar", data:{labels:L(), datasets:[
    {label:"Day-over-day GMV growth", data:g, backgroundColor:g.map(v=>v===null?"#DCE3EA":(v>=0?"#0A7A48":"#B3261E")), borderRadius:3}
  ]}, options:{scales:{y:{grid:GRID, ticks:{callback:v=>v+"%"}}, x:{grid:{display:false}}},
    plugins:{legend:{display:false}, tooltip:{callbacks:{label:c=>c.raw===null?"No prior day in range":"Growth: "+(c.parsed.y>0?"+":"")+c.parsed.y.toFixed(2)+"%"}}}}});
  const gv = g.slice(1);
  const gi = gv.indexOf(Math.max(...gv))+1, li = gv.indexOf(Math.min(...gv))+1;
  document.getElementById("growthNote").innerHTML =
    "Biggest gain <b>"+rows[gi].lbl+"</b> at <b>"+pctp(g[gi]/100,2)+"</b> ("+moneyFull(rows[gi].tAct-rows[gi-1].tAct)+"). "+
    "Biggest fall <b>"+rows[li].lbl+"</b> at <b>"+pctp(g[li]/100,2)+"</b> ("+moneyFull(rows[li].tAct-rows[li-1].tAct)+"). "+
    "Computed from reconciled Dabble + 3P actuals. The workbook's own Growth-Degrowth field is calculated on its Total GMV column, which double-counts Amazon B2B — see the data notes on tab 7 for the reconciliation.";

  const gch = CH.filter(c=>c.inTotal);
  mk("cGrowthContrib", {type:"bar", data:{labels:L().slice(1), datasets:gch.map(c=>({
    label:c.n, data:rows.slice(1).map((r,i)=>c.d(r)-c.d(rows[i])), backgroundColor:c.c, borderRadius:2}))},
    options:{scales:{x:{stacked:true, grid:{display:false}}, y:{stacked:true, grid:GRID, ticks:{callback:v=>money(v)}}},
      plugins:{tooltip:{callbacks:{label:c=>c.dataset.label+": "+(c.parsed.y>=0?"+":"−")+moneyFull(Math.abs(c.parsed.y)),
        footer:it=>"Net change: "+moneyFull(it.reduce((t,i)=>t+i.parsed.y,0))}}}}});

  // week
  const dayTotW = r => r.metaSp+r.amzSp+r.bikSp+(r.blkSp||0)+r.googSp;
  document.getElementById("weekKpis").innerHTML = [
    kpi({acc:A.tAch>=1?"pos":"neg", l:"Week 1 GMV", v:money(A.tAct), f:"Target "+moneyFull(A.tPlan)}),
    kpi({acc:A.tAch>=1?"pos":"neg", l:"Week 1 achievement", v:pct(A.tAch,2), vc:A.tAch>=1?"pos":"neg", f:(A.tVar>=0?"+":"−")+moneyFull(Math.abs(A.tVar))+" vs plan"}),
    kpi({acc:"warn", l:"Week 1 recorded spend", v:money(A.spend), f:pct(A.spendGmv,1)+" of GMV"}),
    kpi({acc:"brand", l:"Week 1 blended ROAS", v:rx(A.blendRoas), f:"GMV ÷ recorded media spend"}),
    kpi({acc:"brand", l:"Website conversion", v:pct(A.conv,2), f:nf(A.orders)+" orders from "+nf(A.traff)+" visits"}),
    kpi({acc:"brand", l:"Website AOV", v:moneyFull(A.aov), f:"GMV ÷ orders"}),
    kpi({acc:"brand", l:"Average GMV per day", v:money(A.tAct/A.n), f:"Across "+A.n+" days, not 7"}),
    kpi({acc:"void", l:"Days covered", v:A.n+" of 7", f:rows[0].dow+" to "+rows[rows.length-1].dow+" · Monday missing"})
  ].join("");
}

/* ==========================================================================
   TAB 7 — ALERTS & CEO INSIGHTS
   ========================================================================== */
function renderInsights(){
  const dayTot = r => r.metaSp+r.amzSp+r.bikSp+(r.blkSp||0)+r.googSp;
  const al = [];
  const add=(sev,t,d,e)=>al.push({sev,t,d,e});

  // 1. 3P achievement
  if(A.pAch < 0.95) add("crit","Marketplace revenue is materially below plan",
    "3P GMV of <b>"+moneyFull(A.pAct)+"</b> against a <b>"+moneyFull(A.pPlan)+"</b> plan is <b>"+pct(A.pAch,1)+"</b> — a <b>"+moneyFull(Math.abs(A.pVar))+"</b> shortfall. 3P is "+pct(A.pAct/A.tAct,0)+" of the business, so this is the single largest gap to plan.",
    "Threshold: 3P achievement below 95%.");

  // 2. concentration
  const sh = [{n:"Amazon",v:A.amzTot},{n:"Website",v:A.webGmv},{n:"FirstCry",v:A.fcGmv},{n:"BlinkIT",v:A.blkGmv}].sort((a,b)=>b.v-a.v);
  if(sh[0].v/A.tAct > 0.45) add("crit","Single-channel concentration risk",
    "<b>"+sh[0].n+"</b> is <b>"+pct(sh[0].v/A.tAct,1)+"</b> of total GMV ("+moneyFull(sh[0].v)+"). The top two channels together are <b>"+pct((sh[0].v+sh[1].v)/A.tAct,1)+"</b>. A policy, ranking or fee change on one platform would move a majority of revenue.",
    "Threshold: any single channel above 45% of GMV.");

  // 3. spend up, GMV down
  const inef = [];
  for(let i=1;i<rows.length;i++) if(rows[i].metaSp>rows[i-1].metaSp*1.05 && rows[i].dAct<rows[i-1].dAct) inef.push(rows[i]);
  if(inef.length) add("crit","Higher website media spend did not produce revenue",
    inef.map(r=>{const p=rows[rows.indexOf(r)-1];
      return "On <b>"+r.lbl+"</b> Meta spend rose "+pctp((r.metaSp-p.metaSp)/p.metaSp,0)+" to <b>"+moneyFull(r.metaSp)+"</b> while website GMV fell "+pctp((r.dAct-p.dAct)/p.dAct,0)+" to <b>"+moneyFull(r.dAct)+"</b>; reported Meta ROAS moved "+rx(p.metaRoas)+" → <b>"+rx(r.metaRoas)+"</b> and cost per order "+moneyFull(p.markSp/p.orders)+" → <b>"+moneyFull(r.markSp/r.orders)+"</b>.";}).join("<br>"),
    "Threshold: Meta spend up more than 5% day over day while website GMV falls.");

  // 4. conversion drop
  const cvs = rows.map(r=>r.orders/r.traff), cx = extremes(cvs);
  if((cvs[cx.hi]-cvs[cx.lo])/cvs[cx.hi] > 0.25) add("watch","Website conversion swung sharply within the period",
    "Conversion ranged from <b>"+pct(cvs[cx.hi],2)+"</b> on "+rows[cx.hi].lbl+" to <b>"+pct(cvs[cx.lo],2)+"</b> on "+rows[cx.lo].lbl+" — a <b>"+pct((cvs[cx.hi]-cvs[cx.lo])/cvs[cx.hi],0)+"</b> relative drop. Cart-to-order held steady over the same span, so the loss sits between landing and add-to-cart.",
    "Threshold: peak-to-trough conversion decline above 25%.");

  // 5. single-day dependency
  const peak = rows.reduce((b,r)=>r.tAct>b.tAct?r:b, rows[0]);
  const peakShare = (peak.dAct-peak.dPlan)/A.dVar;
  if(peakShare > 0.5) add("watch","The beat rests on a single day",
    "<b>"+peak.lbl+"</b> contributes <b>"+pct(peakShare,0)+"</b> of the entire website surplus. Excluding it, the business ran at <b>"+pct(sum(rows.filter(r=>r!==peak),r=>r.tAct)/sum(rows.filter(r=>r!==peak),r=>r.tPlan),1)+"</b> of plan. The uplift came from AOV of <b>"+moneyFull(peak.dAct/peak.orders)+"</b> on only "+peak.orders+" orders and sits largely outside paid sale ("+pct(peak.webPaid/peak.dAct,0)+" paid).",
    "Threshold: one day contributing more than 50% of cumulative variance.");

  // 6. missing data
  const miss = rows.filter(r=>r.blkSp===null);
  if(miss.length) add("watch","Cost data missing for BlinkIT",
    "Spend and ROAS are <b>Not Update Yet</b> for <b>"+miss.map(r=>r.lbl).join(" and ")+"</b>, covering <b>"+moneyFull(A.blkGmvUnknown)+"</b> of GMV. These days are excluded from all ROAS and blended-efficiency figures rather than counted as zero spend, so period spend is understated by an unknown amount.",
    "Threshold: any source field marked not updated.");

  // 7. Meta ROAS
  const mr = Math.min(...rows.map(r=>r.metaRoas)), mri = rows.findIndex(r=>r.metaRoas===mr);
  if(mr < 1.5) add("watch","Meta efficiency fell below 1.5x",
    "Reported Meta ROAS bottomed at <b>"+rx(mr)+"</b> on "+rows[mri].lbl+", on the period's highest spend of <b>"+moneyFull(rows[mri].metaSp)+"</b>. Website blended ROAS on the same day was <b>"+rx(rows[mri].webBlendRoas)+"</b>, also the period low.",
    "Threshold: reported channel ROAS below 1.5x on any day.");

  // 8. Google zero
  if(A.googSp === 0) add("watch","Google Ads records zero spend and zero return",
    "Google Ads shows <b>₹0</b> spend and <b>0</b> ROAS on all "+A.n+" days. Recorded spend is zero. The workbook does not indicate whether the channel is paused, unbudgeted, or simply not being reported — that needs confirming before it is read either way.",
    "Threshold: a tracked channel with no recorded activity across the full period.");

  // 9. BIK decline
  const bd = (rows[rows.length-1].bikGmv-rows[0].bikGmv)/rows[0].bikGmv;
  if(bd < -0.4) add("watch","BIK revenue has collapsed alongside its budget",
    "BIK GMV fell <b>"+pctp(bd,0)+"</b> from "+moneyFull(rows[0].bikGmv)+" to "+moneyFull(rows[rows.length-1].bikGmv)+" as spend was cut <b>"+pctp((rows[rows.length-1].bikSp-rows[0].bikSp)/rows[0].bikSp,0)+"</b>. Reported ROAS rose to "+rx(Math.max(...rows.map(r=>r.bikRoas)))+" only because the spend denominator shrank; in rupees the channel lost <b>"+moneyFull(rows[0].bikGmv-rows[rows.length-1].bikGmv)+"</b> of daily revenue.",
    "Threshold: channel GMV decline above 40% across the period.");

  // 10. AOV volatility
  const av = rows.map(r=>r.dAct/r.orders), ax = extremes(av);
  if(av[ax.hi]/av[ax.lo] > 2) add("watch","Basket size is unstable",
    "AOV ranged from <b>"+moneyFull(av[ax.lo])+"</b> on "+rows[ax.lo].lbl+" to <b>"+moneyFull(av[ax.hi])+"</b> on "+rows[ax.hi].lbl+" — a <b>"+(av[ax.hi]/av[ax.lo]).toFixed(1)+"x</b> spread. Reported new-buyer AOV on "+rows[ax.hi].lbl+" was <b>"+moneyFull(rows[ax.hi].nbAov)+"</b>. Forecasting off the period average of "+moneyFull(A.aov)+" would be misleading.",
    "Threshold: peak-to-trough AOV ratio above 2x.");

  // 11. spend intensity
  const mki = extremes(rows.map(r=>r.markPct));
  if(rows[mki.hi].markPct > 0.55) add("watch","Marketing intensity spiked on one day",
    "On <b>"+rows[mki.hi].lbl+"</b> marketing spend reached <b>"+pct(rows[mki.hi].markPct,1)+"</b> of website GMV ("+moneyFull(rows[mki.hi].markSp)+" on "+moneyFull(rows[mki.hi].dAct)+"), against a period average of <b>"+pct(A.spOverGmv,1)+"</b>. Cost per order that day was <b>"+moneyFull(rows[mki.hi].markSp/rows[mki.hi].orders)+"</b>.",
    "Threshold: single-day marketing spend above 55% of GMV.");

  // healthy
  if(A.dAch >= 1) add("ok","Website is ahead of plan",
    "Website GMV of <b>"+moneyFull(A.dAct)+"</b> against a <b>"+moneyFull(A.dPlan)+"</b> plan is <b>"+pct(A.dAch,1)+"</b>, beating plan on "+rows.filter(r=>r.dAct>=r.dPlan).length+" of "+A.n+" days.", "");
  if(A.nrRatio > 0.8) add("ok","Revenue quality is stable",
    "Net revenue is <b>"+pct(A.nrRatio,1)+"</b> of website GMV and holds within <b>"+pct(Math.min(...rows.map(r=>r.netRev/r.dAct)),1)+"</b>–<b>"+pct(Math.max(...rows.map(r=>r.netRev/r.dAct)),1)+"</b> on every day. No leakage in the take rate.", "");
  const amzT = (rows[rows.length-1].amzTot-rows[0].amzTot)/rows[0].amzTot;
  if(amzT > 0) add("ok","Amazon revenue is growing",
    "Amazon total GMV moved <b>"+pctp(amzT,1)+"</b> across the period to <b>"+moneyFull(rows[rows.length-1].amzTot)+"</b>, with a peak of "+moneyFull(Math.max(...rows.map(r=>r.amzTot)))+". Blended ROAS averaged <b>"+rx(A.amzTot/A.amzSp)+"</b>.", "");

  const order = {crit:0, watch:1, ok:2};
  const dot = {crit:"🔴", watch:"🟠", ok:"🟢"};
  al.sort((a,b)=>order[a.sev]-order[b.sev]);
  document.getElementById("alertBox").innerHTML = al.map(a=>
    '<div class="alert"><div class="dot">'+dot[a.sev]+'</div><div><div class="ttl">'+a.t+'</div><div class="dsc">'+a.d+'</div>'+(a.e?'<div class="evd">'+a.e+'</div>':'')+'</div></div>').join("");

  // CEO insights
  const peak2 = rows.reduce((b,r)=>r.tAct>b.tAct?r:b, rows[0]);
  const prev2 = rows[rows.indexOf(peak2)-1];
  const rest = rows.filter(r=>r!==peak2);
  document.getElementById("ceoInsights").innerHTML = [
    ins({t:"pos", open:true, h:"What is going well", b:"<ul>"+
      "<li>Website GMV of <b>"+moneyFull(A.dAct)+"</b> is <b>"+pct(A.dAch,1)+"</b> of plan, <b>+"+moneyFull(A.dVar)+"</b>.</li>"+
      "<li>Amazon grew <b>"+pctp((rows[rows.length-1].amzTot-rows[0].amzTot)/rows[0].amzTot,1)+"</b> and remains the largest channel at <b>"+moneyFull(A.amzTot)+"</b>.</li>"+
      "<li>Net revenue holds at <b>"+pct(A.nrRatio,1)+"</b> of GMV every day — discounting is not eroding the take rate.</li>"+
      "<li>Returning visitors convert at <b>"+pct(A.rbConv,2)+"</b> against <b>"+pct(A.nbConv,2)+"</b> for new traffic.</li></ul>"}),
    ins({t:"neg", open:true, h:"What is not going well", b:"<ul>"+
      "<li>3P is <b>"+pct(A.pAch,1)+"</b> of plan, <b>"+moneyFull(Math.abs(A.pVar))+"</b> short — the reason the group beat is only <b>"+pct(A.tAch,1)+"</b>.</li>"+
      "<li>Website traffic fell from <b>"+nf(Math.max(...rows.map(r=>r.traff)))+"</b> to <b>"+nf(rows[rows.length-1].traff)+"</b> and conversion bottomed at <b>"+pct(Math.min(...rows.map(r=>r.orders/r.traff)),2)+"</b>.</li>"+
      "<li>Meta spend peaked at <b>"+moneyFull(Math.max(...rows.map(r=>r.metaSp)))+"</b> on the day website GMV was weakest, pushing cost per order to <b>"+moneyFull(Math.max(...rows.map(r=>r.markSp/r.orders)))+"</b>.</li>"+
      "<li>BIK GMV fell <b>"+pctp((rows[rows.length-1].bikGmv-rows[0].bikGmv)/rows[0].bikGmv,0)+"</b>, a loss of <b>"+moneyFull(rows[0].bikGmv-rows[rows.length-1].bikGmv)+"</b> in daily revenue.</li></ul>"}),
    ins({t:"brand", h:"What is driving the business", b:"<ul>"+
      "<li>Amazon supplies <b>"+pct(A.amzTot/A.tAct,1)+"</b> of GMV; the website supplies <b>"+pct(A.webGmv/A.tAct,1)+"</b>. Everything else is <b>"+pct((A.blkGmv+A.fcGmv+A.tmsGmv)/A.tAct,1)+"</b>.</li>"+
      "<li>Website GMV growth is basket-led, not demand-led: orders fell <b>"+pctp((rows[rows.length-1].orders-rows[0].orders)/rows[0].orders,0)+"</b> while AOV rose <b>"+pctp(((rows[rows.length-1].dAct/rows[rows.length-1].orders)-(rows[0].dAct/rows[0].orders))/(rows[0].dAct/rows[0].orders),0)+"</b>.</li>"+
      "<li>New buyers place <b>"+pct(A.nbOrd/A.orders,0)+"</b> of orders; returning buyers deliver the better conversion and the lower risk.</li></ul>"}),
    ins({t:"warn", h:"Where spend is increasing, and whether it is working", b:"<ul>"+
      "<li>Total recorded media <b>"+moneyFull(A.spend)+"</b> = <b>"+pct(A.spendGmv,1)+"</b> of GMV, blended <b>"+rx(A.blendRoas)+"</b>.</li>"+
      "<li>Amazon spend rose every single day, <b>"+moneyFull(rows[0].amzSp)+"</b> → <b>"+moneyFull(rows[rows.length-1].amzSp)+"</b>. GMV grew, but blended ROAS slipped to <b>"+rx(rows[rows.length-1].amzTot/rows[rows.length-1].amzSp)+"</b> on the last day, its weakest.</li>"+
      "<li>Meta spend rose <b>"+pctp((Math.max(...rows.map(r=>r.metaSp))-rows[0].metaSp)/rows[0].metaSp,0)+"</b> to its peak while website GMV <i>fell</i> — the clearest case of spend not converting to revenue in this period.</li>"+
      "<li>Website media absorbs <b>"+pct(A.spOverNr,1)+"</b> of website net revenue.</li></ul>"}),
    ins({t:"pos", h:"What to scale, what to fix", b:"<ul>"+
      "<li><b>Scale carefully:</b> Amazon — largest channel, growing, <b>"+rx(A.amzTot/A.amzSp)+"</b> blended. Add budget only while efficiency holds; the last-day dip is the thing to watch.</li>"+
      "<li><b>Fix first:</b> Meta / website media — <b>"+moneyFull(A.webAds)+"</b> at <b>"+rx(A.webGmv/A.webAds)+"</b> blended, with reported ROAS as low as <b>"+rx(Math.min(...rows.map(r=>r.metaRoas)))+"</b>. This is the largest controllable inefficiency.</li>"+
      "<li><b>Test:</b> BIK — <b>"+rx(A.bikGmv/A.bikSp)+"</b> blended on <b>"+pct(A.bikSp/A.spend,1)+"</b> of media. Restore a measured budget and check whether revenue returns.</li>"+
      "<li><b>Resolve reporting:</b> BlinkIT (two days missing) and Google (₹0 recorded) before either is judged.</li></ul>"}),
    ins({t:"brand", h:"Is website performance healthy", b:"<ul>"+
      "<li>Against plan, yes — <b>"+pct(A.dAch,1)+"</b>. Against its own funnel, not really.</li>"+
      "<li>Traffic <b>"+pctp((rows[rows.length-1].traff-rows[0].traff)/rows[0].traff,1)+"</b>, orders <b>"+pctp((rows[rows.length-1].orders-rows[0].orders)/rows[0].orders,1)+"</b>, ATC rate <b>"+pct(rows[0].atc/rows[0].traff,1)+"</b> → <b>"+pct(rows[rows.length-1].atc/rows[rows.length-1].traff,1)+"</b>.</li>"+
      "<li>Excluding the peak day, website GMV across the other "+rest.length+" days was <b>"+moneyFull(sum(rest,r=>r.dAct))+"</b> at <b>"+pct(sum(rest,r=>r.dAct)/sum(rest,r=>r.dPlan),1)+"</b> of plan — still ahead, but on a declining funnel.</li>"+
      "<li>Revenue per visitor averaged <b>"+moneyFull(A.rpv)+"</b>; five of "+A.n+" days sat below that.</li></ul>"}),
    ins({t:"warn", h:"What changed materially on "+peak2.lbl, b:"<ul>"+
      "<li>Total GMV <b>"+moneyFull(peak2.tAct)+"</b>, <b>"+pctp((peak2.tAct-prev2.tAct)/prev2.tAct,1)+"</b> day over day and <b>"+pct(peak2.tAct/peak2.tPlan,0)+"</b> of plan.</li>"+
      "<li>All of it is website: website <b>+"+moneyFull(peak2.dAct-prev2.dAct)+"</b> while Amazon <b>"+moneyFull(peak2.amzTot-prev2.amzTot)+"</b>, BlinkIT <b>"+moneyFull(peak2.blkGmv-prev2.blkGmv)+"</b>, FirstCry <b>"+moneyFull(peak2.fcGmv-prev2.fcGmv)+"</b> and BIK <b>"+moneyFull(peak2.bikGmv-prev2.bikGmv)+"</b> all fell.</li>"+
      "<li>It is not volume: traffic was the period's lowest at <b>"+nf(peak2.traff)+"</b> and orders were <b>"+peak2.orders+"</b>. AOV went <b>"+moneyFull(prev2.dAct/prev2.orders)+"</b> → <b>"+moneyFull(peak2.dAct/peak2.orders)+"</b>.</li>"+
      "<li>It is not media: paid sale was flat at <b>"+moneyFull(peak2.webPaid)+"</b>, only <b>"+pct(peak2.webPaid/peak2.dAct,0)+"</b> of website GMV against <b>"+pct(prev2.webPaid/prev2.dAct,0)+"</b> the day before.</li>"+
      "<li>Reported new-buyer AOV was <b>"+moneyFull(peak2.nbAov)+"</b>. A small number of very large orders is the only explanation the data supports — verify before forecasting on it.</li></ul>"}),
    ins({t:"neg", h:"What management should watch next", b:"<ul>"+
      "<li><b>Marketplace recovery.</b> 3P must close <b>"+moneyFull(Math.abs(A.pVar))+"</b>. At the current daily run rate of <b>"+moneyFull(A.pAct/A.n)+"</b> against a plan of <b>"+moneyFull(A.pPlan/A.n)+"</b>, the gap widens each day it is not addressed.</li>"+
      "<li><b>Whether "+peak2.lbl+" repeats.</b> If it does not, the period beat does not carry into next week.</li>"+
      "<li><b>Website conversion.</b> It recovered to <b>"+pct(rows[rows.length-1].orders/rows[rows.length-1].traff,2)+"</b> on falling traffic. Confirm whether the mid-period drop was traffic quality or a site issue — the workbook cannot distinguish the two.</li>"+
      "<li><b>Amazon efficiency as spend rises.</b> Blended ROAS at its weakest on the last day while spend was at its highest.</li>"+
      "<li><b>Close the reporting gaps.</b> BlinkIT cost for "+miss.map(r=>r.lbl).join(" and ")+", Google's zero, and the Total GMV double-count all need resolving before the next review.</li></ul>"})
  ].join("");

  // data notes
  const repDiff = A.totRep - A.tAct;
  document.getElementById("dataNotes").innerHTML =
    '<div class="grid g2">'+
    '<div><h4 style="font-size:13.5px;margin-bottom:8px">Validated against the workbook</h4><div style="font-size:12.8px;color:var(--ink-2);line-height:1.75">'+
      '<div>Dabble plan — computed <b>'+moneyFull(A.dPlan)+'</b>, workbook <b>'+moneyFull(BOOK.dPlan)+'</b> <span class="badge b-pos">ties</span></div>'+
      '<div>Dabble actual — computed <b>'+moneyFull(A.dAct)+'</b>, workbook <b>'+moneyFull(BOOK.dAct)+'</b> <span class="badge b-pos">ties</span></div>'+
      '<div>Dabble achievement — computed <b>'+pct(A.dAch,2)+'</b>, workbook <b>'+pct(BOOK.dAch,2)+'</b> <span class="badge b-pos">ties</span></div>'+
      '<div>Dabble + 3P plan — computed <b>'+moneyFull(A.tPlan)+'</b>, workbook <b>'+moneyFull(BOOK.tPlan)+'</b> <span class="badge b-pos">ties</span></div>'+
      '<div>Dabble + 3P actual — computed <b>'+moneyFull(A.tAct)+'</b>, workbook <b>'+moneyFull(BOOK.tAct)+'</b> <span class="badge b-pos">ties</span></div>'+
      '<div>Dabble + 3P achievement — computed <b>'+pct(A.tAch,2)+'</b>, workbook <b>'+pct(BOOK.tAch,2)+'</b> <span class="badge b-pos">ties</span></div>'+
      '<div style="margin-top:8px">Website GMV reconciles to Dabble GMV to the rupee on all '+A.n+' days.</div>'+
      '<div>Channel GMV (website + Amazon total + BlinkIT + FirstCry + The Moms Store) reconciles to Dabble + 3P actual within ₹1 per day.</div>'+
      '<div>Reported Conv, CPU and Mark% all reproduce exactly from orders, traffic, spend and GMV.</div>'+
    '</div></div>'+
    '<div><h4 style="font-size:13.5px;margin-bottom:8px">Discrepancies found and how they are handled</h4><div style="font-size:12.8px;color:var(--ink-2);line-height:1.75">'+
      '<div><span class="badge b-warn">Total GMV column</span> The channel sheet\'s Total GMV sums to <b>'+moneyFull(A.totRep)+'</b>, <b>'+moneyFull(repDiff)+'</b> above the reconciled <b>'+moneyFull(A.tAct)+'</b>. The gap is Amazon B2B (<b>'+moneyFull(A.amzB2b)+'</b>) counted twice, less The Moms Store (<b>₹759</b>) omitted on Sep 1. This dashboard uses the reconciled figure throughout.</div>'+
      '<div style="margin-top:8px"><span class="badge b-warn">AOV column</span> The website sheet\'s AOV equals net revenue ÷ orders on three days but matches nothing on Sep 1, Sep 4 and Sep 5. AOV here is computed as <b>GMV ÷ orders</b> and stated as such.</div>'+
      '<div style="margin-top:8px"><span class="badge b-warn">Segment traffic</span> Returning plus new traffic is <b>'+nf(A.trAttrib)+'</b> against a site total of <b>'+nf(A.traff)+'</b>. <b>'+nf(A.trGap)+'</b> visits ('+pct(A.trGap/A.traff,1)+') are unattributed; segment rates use identified traffic only.</div>'+
      '<div style="margin-top:8px"><span class="badge b-warn">Segment spend</span> RB plus NB spend is <b>'+moneyFull(A.rbSp+A.nbSp)+'</b> against marketing spend of <b>'+moneyFull(A.markSp)+'</b>. Recorded new-buyer cost per order is below returning — the reverse of the usual pattern. Flagged, not adjusted.</div>'+
      '<div style="margin-top:8px"><span class="badge b-warn">Website Ads Spends</span> The website media line totals <b>'+moneyFull(A.webAds)+'</b> while Meta plus BIK totals <b>'+moneyFull(A.metaSp+A.bikSp)+'</b> — a <b>'+moneyFull(Math.abs(A.metaSp+A.bikSp-A.webAds))+'</b> gap traceable to BIK spend landing on the wrong row in that column. Total recorded spend on the Spend tab (<b>'+moneyFull(A.spend)+'</b>) is built from the individual platform lines.</div>'+
      '<div style="margin-top:8px"><span class="badge b-void">Not updated</span> BlinkIT spend and ROAS for '+rows.filter(r=>r.blkSp===null).map(r=>r.lbl).join(" and ")+'. Excluded from all calculations; never read as zero.</div>'+
      '<div style="margin-top:8px"><span class="badge b-void">Zero, not absent</span> Google Ads spend and ROAS are recorded as 0 on every day. Shown as ₹0 recorded, with no inference about whether the channel was paused.</div>'+
      '<div style="margin-top:8px"><span class="badge b-brand">Not double counted</span> BIK GMV sits inside Website GMV Total (the column header says so). It is reported separately for visibility but excluded from channel contribution totals.</div>'+
    '</div></div></div>';
}

/* ==========================================================================
   WIRING
   ========================================================================== */
function renderAll(){
  A = agg(rows);
  document.getElementById("periodSub").textContent =
    rows[0].lbl+"–"+rows[rows.length-1].lbl.replace("Sep ","")+", 2026 · Week 1 ("+
    (A.n===6 ? "partial week, 6 of 7 days" : A.n+" of 7 days selected")+")";
  renderExec(); renderTarget(); renderFunnel(); renderChannel(); renderSpend(); renderDaily(); renderInsights();
}
function buildSelects(){
  const f=document.getElementById("dFrom"), t=document.getElementById("dTo");
  D.forEach((r,i)=>{
    f.insertAdjacentHTML("beforeend",'<option value="'+i+'">'+r.lbl+' · '+r.dow+'</option>');
    t.insertAdjacentHTML("beforeend",'<option value="'+i+'">'+r.lbl+' · '+r.dow+'</option>');
  });
  f.value=0; t.value=5;
  const sync=()=>{
    FROM=+f.value; TO=+t.value;
    if(TO<FROM){ TO=FROM; t.value=TO; }
    if(TO-FROM < 1){ TO=Math.min(5, FROM+1); t.value=TO; }   // need ≥2 days for trends
    rows=D.slice(FROM,TO+1); renderAll();
  };
  f.onchange=sync; t.onchange=sync;
  document.getElementById("btnReset").onclick=()=>{f.value=0; t.value=5; sync();};
}
document.querySelectorAll(".tab").forEach(b=>b.onclick=()=>{
  document.querySelectorAll(".tab").forEach(x=>x.setAttribute("aria-selected", x===b ? "true":"false"));
  document.querySelectorAll(".panel").forEach(p=>p.hidden = p.id!==b.dataset.p);
  window.scrollTo({top:0, behavior:"instant"});
  Object.values(REG).forEach(c=>c.resize());
});
buildSelects();
renderAll();
</script>
</body>
</html>

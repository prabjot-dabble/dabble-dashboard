  document.getElementById("spendKpis").innerHTML = [
    kpi({acc:"warn", l:"Total recorded media spend", v:money(A.spend), f:moneyFull(A.spend)+" across "+A.n+" days"}),
    kpi({acc:"warn", l:"Spend ÷ total GMV", v:pct(A.spendGmv,1), f:"₹"+(A.spendGmv*100).toFixed(0)+" of media per ₹100 of GMV"}),
    kpi({acc:A.blendRoas>=3?"pos":"warn", l:"Blended ROAS (all channels)", v:rx(A.blendRoas), f:moneyFull(A.tAct)+" GMV ÷ "+moneyFull(A.spend)+" spend"}),
    kpi({acc:"neg", l:"Heaviest spend day", v:rows[spEx.hi].lbl, f:moneyFull(dayTot(rows[spEx.hi]))+" · "+pct(dayTot(rows[spEx.hi])/A.spend,1)+" of period media"}),
    kpi({acc:"brand", l:"Meta ads", v:money(A.metaSp), f:pct(A.metaSp/A.spend,1)+" of media · returns "+rx(A.webPaid/A.metaSp)+" on paid sale"}),
    kpi({acc:"brand", l:"Amazon ads", v:money(A.amzSp), f:pct(A.amzSp/A.spend,1)+" of media · "+rx(A.amzTot/A.amzSp)+" blended"}),
    kpi({acc:"void", l:"Google ads", v:"₹0 recorded", f:"Zero spend and zero ROAS recorded on all "+A.n+" days"}),
    kpi({acc:"void", l:"BlinkIT", v:money(A.blkSp), f:"Recorded for "+A.blkSpDays+" of "+A.n+" days only"})
  ].join("");

  mk("cSpendStack", {type:"bar", data:{labels:L(), datasets:SP.filter(s=>A[s.k]>0 || s.k==="blkSp").map(s=>({
    label:s.n, data:rows.map(r=>r[s.k]), backgroundColor:s.c, borderRadius:2}))},
    options:{scales:{x:{stacked:true, grid:{display:false}}, y:{stacked:true, grid:GRID, ticks:{callback:v=>money(v)}}},
      plugins:{tooltip:{callbacks:{label:c=>c.raw===null?c.dataset.label+": Not Updated":c.dataset.label+": "+moneyFull(c.parsed.y),
        footer:it=>"Recorded total: "+moneyFull(it.reduce((t,i)=>t+(i.raw||0),0))}}}}});
  document.getElementById("spendStackNote").innerHTML =
    "Meta (<b>"+pct(A.metaSp/A.spend,1)+"</b>) and Amazon (<b>"+pct(A.amzSp/A.spend,1)+"</b>) are <b>"+pct((A.metaSp+A.amzSp)/A.spend,1)+"</b> of all recorded media. "+
    "BIK is <b>"+pct(A.bikSp/A.spend,1)+"</b> and BlinkIT <b>"+pct(A.blkSp/A.spend,1)+"</b>. Google records ₹0 throughout. "+
    "Bars for BlinkIT are absent on days marked Not Updated rather than drawn at zero.";

  mk("cSpendVsGmv", {type:"bar", data:{labels:L(), datasets:[
    {label:"Recorded spend", data:rows.map(dayTot), backgroundColor:"#9CC3DD", borderRadius:3, yAxisID:"y"},
    {label:"Total GMV", data:rows.map(r=>r.tAct), backgroundColor:"#12496E", borderRadius:3, yAxisID:"y"},
    {type:"line", label:"Blended ROAS", data:rows.map(r=>r.tAct/dayTot(r)), yAxisID:"y1", borderColor:"#B3261E", backgroundColor:"#B3261E", borderWidth:2.5, pointRadius:4, tension:.3}
  ]}, options:{scales:{y:{grid:GRID, ticks:{callback:v=>money(v)}}, y1:{position:"right", grid:{display:false}, ticks:{callback:v=>v.toFixed(1)+"x"}, min:0}, x:{grid:{display:false}}},
    plugins:{tooltip:{callbacks:{label:c=>c.dataset.yAxisID==="y1"?c.dataset.label+": "+rx(c.parsed.y):c.dataset.label+": "+moneyFull(c.parsed.y)}}}}});

  // spend vs GMV narrative — find days where spend rose but website GMV fell
  const bad = [];
  for(let i=1;i<rows.length;i++){
    if(rows[i].metaSp>rows[i-1].metaSp && rows[i].dAct<rows[i-1].dAct)
      bad.push(rows[i].lbl+" (Meta spend "+pctp((rows[i].metaSp-rows[i-1].metaSp)/rows[i-1].metaSp,0)+", website GMV "+pctp((rows[i].dAct-rows[i-1].dAct)/rows[i-1].dAct,0)+")");
  }
  document.getElementById("spendGmvNote").innerHTML =
    (bad.length ? "<b>Increased spend did not buy revenue on "+bad.length+" day"+(bad.length>1?"s":"")+":</b> "+bad.join("; ")+". "
                : "On every day in this range, higher Meta spend coincided with higher website GMV. ")+
    "Blended ROAS ranged from <b>"+rx(Math.min(...rows.map(r=>r.tAct/dayTot(r))))+"</b> to <b>"+rx(Math.max(...rows.map(r=>r.tAct/dayTot(r))))+"</b>, with the weakest reading on "+rows[extremes(rows.map(r=>r.tAct/dayTot(r))).lo].lbl+".";

  // ROAS comparison
  const roasCh = [
    {n:"BIK", rep:A.bikGmv/A.bikSp, sp:A.bikSp, c:"#6B4E9E"},
    {n:"BlinkIT", rep:A.blkSpDays?A.blkGmvKnown/A.blkSp:null, sp:A.blkSp, c:"#A9761B"},
    {n:"Amazon", rep:A.amzTot/A.amzSp, sp:A.amzSp, c:"#2C86BF"},
    {n:"Website (blended)", rep:A.webGmv/A.webAds, sp:A.webAds, c:"#12496E"},
    {n:"Meta (on paid sale)", rep:A.webPaid/A.metaSp, sp:A.metaSp, c:"#1E6C9E"},
    {n:"Google", rep:null, sp:A.googSp, c:"#B4690E"}
  ];
  mk("cRoas", {type:"bar", data:{labels:roasCh.map(c=>c.n), datasets:[
    {label:"Blended ROAS", data:roasCh.map(c=>c.rep), backgroundColor:roasCh.map(c=>c.c), borderRadius:3, yAxisID:"y"},
    {type:"line", label:"Recorded spend", data:roasCh.map(c=>c.sp), yAxisID:"y1", borderColor:"#B3261E", backgroundColor:"#B3261E", borderWidth:0, pointRadius:6, pointStyle:"rectRot", showLine:false}
  ]}, options:{scales:{y:{grid:GRID, ticks:{callback:v=>v+"x"}, title:{display:true, text:"Blended ROAS"}},
      y1:{position:"right", grid:{display:false}, ticks:{callback:v=>money(v)}, title:{display:true, text:"Spend"}}, x:{grid:{display:false}}},
    plugins:{tooltip:{callbacks:{label:c=>c.dataset.yAxisID==="y1"?"Spend: "+moneyFull(c.parsed.y):(c.parsed.y===null?"Not calculable — no spend recorded":"Blended ROAS: "+rx(c.parsed.y))}}}}});

  // quadrant
  const medSp = A.spend/4;
  const q = (t,cls,items,adv)=>'<div style="margin-bottom:14px"><div style="font-size:13px;font-weight:600" class="'+cls+'">'+t+'</div><div style="font-size:12.5px;color:var(--ink-2);margin:4px 0 6px">'+adv+'</div>'+
    (items.length?items.map(i=>'<div style="font-size:12.5px;padding:4px 0;border-bottom:1px solid var(--line-2)">'+i+'</div>').join(""):'<div style="font-size:12.5px" class="muted">No channel in this quadrant.</div>')+'</div>';
  document.getElementById("quadBox").innerHTML =
    q("High spend, high return","pos",
      ["<b>Amazon</b> — "+moneyFull(A.amzSp)+" of spend at "+rx(A.amzTot/A.amzSp)+" blended, "+pct(A.amzTot/A.tAct,1)+" of GMV. Efficiency softened on the last day; watch that before adding budget."],
      "Scale, provided efficiency holds as budget rises.") +
    q("High spend, low return","neg",
      ["<b>Meta / website media</b> — "+moneyFull(A.webAds)+" of spend returning "+rx(A.webGmv/A.webAds)+" blended and "+rx(A.webPaid/A.metaSp)+" on paid sale. Reported Meta ROAS fell to "+rx(Math.min(...rows.map(r=>r.metaRoas)))+" on "+rows[extremes(rows.map(r=>r.metaRoas)).lo].lbl+", when spend was at its highest ("+moneyFull(Math.max(...rows.map(r=>r.metaSp)))+")."],
      "Optimisation priority. This is the largest controllable inefficiency in the period.") +
    q("Low spend, high return","warn",
      ["<b>BIK</b> — "+rx(A.bikGmv/A.bikSp)+" blended on just "+moneyFull(A.bikSp)+" ("+pct(A.bikSp/A.spend,1)+" of media). But GMV fell "+pctp((rows[rows.length-1].bikGmv-rows[0].bikGmv)/rows[0].bikGmv,0)+" as spend was cut, so the high ratio reflects a shrinking denominator.",
       "<b>BlinkIT</b> — "+(A.blkSpDays?rx(A.blkGmvKnown/A.blkSp):"—")+" on recorded days, "+moneyFull(A.blkSp)+" of spend. Two days of cost data are missing, so this reading is incomplete."],
      "Test a controlled budget increase and measure incremental GMV, not ratio.") +
    q("Low spend, low return","muted",
      ["<b>Google ads</b> — ₹0 spend and 0 ROAS recorded on every day. Recorded spend is zero; the workbook does not say whether the channel was intentionally paused.",
       "<b>FirstCry</b> and <b>The Moms Store</b> — GMV of "+moneyFull(A.fcGmv)+" and "+moneyFull(A.tmsGmv)+" with no spend recorded, so no efficiency can be computed."],
      "Monitor. Confirm whether missing spend is a reporting gap or a real pause.");

  const dEx = {sp:extremes(rows.map(dayTot)), ro:extremes(rows.map(r=>r.tAct/dayTot(r)))};
  document.getElementById("tSpend").innerHTML = tbl(
    ["Date","Meta","Google","BIK","Amazon","BlinkIT","Recorded total","Total GMV","Spend ÷ GMV","Blended ROAS","Meta ROAS (reported)"],
    rows.map((r,i)=>"<tr><td>"+r.lbl+"</td><td>"+moneyFull(r.metaSp)+"</td><td class='muted'>₹0</td><td>"+moneyFull(r.bikSp)+"</td><td>"+moneyFull(r.amzSp)+"</td>"+
      (r.blkSp===null?'<td class="cell-na">Not Updated</td>':"<td>"+moneyFull(r.blkSp)+"</td>")+
      hcell(dayTot(r),i,dEx.sp,v=>moneyFull(v),true)+
      "<td>"+moneyFull(r.tAct)+"</td><td>"+pct(dayTot(r)/r.tAct,1)+"</td>"+
      hcell(r.tAct/dayTot(r),i,dEx.ro,v=>rx(v))+
      "<td>"+rx(r.metaRoas)+"</td></tr>").join(""),
    "<tr><td>Total</td><td>"+moneyFull(A.metaSp)+"</td><td>₹0</td><td>"+moneyFull(A.bikSp)+"</td><td>"+moneyFull(A.amzSp)+"</td><td>"+moneyFull(A.blkSp)+"</td><td>"+moneyFull(A.spend)+"</td><td>"+moneyFull(A.tAct)+"</td><td>"+pct(A.spendGmv,1)+"</td><td>"+rx(A.blendRoas)+"</td><td>—</td></tr>");

/* ==========================================================================
   TAB 5 — SPEND & ROAS
   ========================================================================== */
const SP = [
  {k:"metaSp", n:"Meta ads", c:"#1E6C9E"},
  {k:"amzSp",  n:"Amazon ads", c:"#2C86BF"},
  {k:"bikSp",  n:"BIK", c:"#6B4E9E"},
  {k:"blkSp",  n:"BlinkIT", c:"#A9761B"},
  {k:"googSp", n:"Google ads", c:"#B4690E"}
];
function renderSpend(){
  const spEx = extremes(rows.map(r=>r.metaSp+r.amzSp+r.bikSp+(r.blkSp||0)+r.googSp));

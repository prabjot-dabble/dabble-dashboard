  ];
  const drops = [
    "ATC rate <b>"+pct(A.atcRate,2)+"</b> — "+nf(A.traff-A.atc)+" visits left without adding to cart",
    "Cart to order <b>"+pct(A.a2o,1)+"</b> — "+nf(A.atc-A.orders)+" carts did not convert",
    "AOV <b>"+moneyFull(A.aov)+"</b> per order · revenue per visitor <b>"+moneyFull(A.rpv)+"</b>"
  ];
  let fh = "";
  steps.forEach((s,i)=>{
    fh += '<div class="fstep"><div class="fbar" style="width:'+(s.w*100).toFixed(1)+'%"></div><div class="fin"><span class="fl" style="color:'+(s.w>.45?"#fff":"var(--ink)")+'">'+s.l+'</span><span class="fv" style="color:'+(s.w>.85?"#fff":"var(--ink)")+'">'+s.d+'</span></div></div>';
    if(drops[i]) fh += '<div class="fdrop">↓ '+drops[i]+'</div>';
  });
  document.getElementById("funnelBox").innerHTML = fh;

  document.getElementById("funnelMini").innerHTML = [
    ["ATC rate", pct(A.atcRate,2), "ATC ÷ traffic"],
    ["Conversion rate", pct(A.conv,2), "orders ÷ traffic"],
    ["Cart to order", pct(A.a2o,1), "orders ÷ ATC"],
    ["AOV", moneyFull(A.aov), "GMV ÷ orders"],
    ["Revenue per visitor", moneyFull(A.rpv), "GMV ÷ traffic"],
    ["Orders", nf(A.orders), "over "+A.n+" days"]
  ].map(m=>'<div><div class="m-l">'+m[0]+'</div><div class="m-v">'+m[1]+'</div><div class="m-f">'+m[2]+'</div></div>').join("");

  mk("cFunnelRates", {type:"line", data:{labels:L(), datasets:[
    {label:"ATC rate", data:rows.map(r=>r.atc/r.traff*100), borderColor:"#2C86BF", backgroundColor:"#2C86BF", tension:.3, borderWidth:2.5, pointRadius:3.5},
    {label:"Conversion rate", data:rows.map(r=>r.orders/r.traff*100), borderColor:"#12496E", backgroundColor:"#12496E", tension:.3, borderWidth:2.5, pointRadius:3.5},
    {label:"Cart to order", data:rows.map(r=>r.orders/r.atc*100), borderColor:"#A9761B", backgroundColor:"#A9761B", tension:.3, borderWidth:2, borderDash:[4,3], pointRadius:3}
  ]}, options:{scales:{y:{grid:GRID, ticks:{callback:v=>v+"%"}}, x:{grid:{display:false}}},
    plugins:{tooltip:{callbacks:{label:c=>c.dataset.label+": "+c.parsed.y.toFixed(2)+"%"}}}}});

  // toggle chips
  const vol = [["traff","Traffic"],["atc","Add to cart"],["orders","Orders"]];
  const rate = [["conv","Conversion %"],["atcr","ATC rate %"],["aov","AOV ₹"],["rpv","Revenue per visitor ₹"],["gmv","GMV ₹"]];
  document.getElementById("funnelToggle").innerHTML =
    '<span class="muted" style="font-size:12px">Volume (left axis)</span>'+
    vol.map(v=>'<button class="chip" data-vol="'+v[0]+'" aria-pressed="'+(volSel[v[0]]?"true":"false")+'">'+v[1]+'</button>').join("")+
    '<span class="muted" style="font-size:12px; margin-left:10px">Compare with (right axis)</span>'+
    rate.map(v=>'<button class="chip" data-rate="'+v[0]+'" aria-pressed="'+(rateSel===v[0]?"true":"false")+'">'+v[1]+'</button>').join("");
  document.querySelectorAll("[data-vol]").forEach(b=>b.onclick=()=>{const k=b.dataset.vol;
    if(volSel[k] && Object.values(volSel).filter(Boolean).length===1) return; volSel[k]=volSel[k]?0:1; renderFunnel();});
  document.querySelectorAll("[data-rate]").forEach(b=>b.onclick=()=>{rateSel=b.dataset.rate; renderFunnel();});

  const rMap = {
    conv:{l:"Conversion %", f:r=>r.orders/r.traff*100, fm:v=>v.toFixed(2)+"%"},
    atcr:{l:"ATC rate %",   f:r=>r.atc/r.traff*100,   fm:v=>v.toFixed(2)+"%"},
    aov:{l:"AOV ₹",         f:r=>r.dAct/r.orders,     fm:v=>moneyFull(v)},
    rpv:{l:"Revenue per visitor ₹", f:r=>r.dAct/r.traff, fm:v=>moneyFull(v)},
    gmv:{l:"GMV ₹",         f:r=>r.dAct,              fm:v=>moneyFull(v)}
  };
  const vMap = {traff:{l:"Traffic",c:"#9CC3DD"}, atc:{l:"Add to cart",c:"#2C86BF"}, orders:{l:"Orders",c:"#12496E"}};
  const ds = Object.keys(volSel).filter(k=>volSel[k]).map(k=>({
    type:"bar", label:vMap[k].l, data:rows.map(r=>r[k]), backgroundColor:vMap[k].c, borderRadius:3, yAxisID:"y"}));
  ds.push({type:"line", label:rMap[rateSel].l, data:rows.map(rMap[rateSel].f), yAxisID:"y1",
    borderColor:"#B3261E", backgroundColor:"#B3261E", borderWidth:2.5, pointRadius:4, tension:.3});
  mk("cFunnelDaily", {data:{labels:L(), datasets:ds}, options:{
    scales:{y:{grid:GRID, title:{display:true, text:"Count"}}, y1:{position:"right", grid:{display:false},
      ticks:{callback:v=>rMap[rateSel].fm(v)}, title:{display:true, text:rMap[rateSel].l}}, x:{grid:{display:false}}},
    plugins:{tooltip:{callbacks:{label:c=>c.dataset.yAxisID==="y1" ? c.dataset.label+": "+rMap[rateSel].fm(c.parsed.y) : c.dataset.label+": "+nf(c.parsed.y)}}}}});

  // diagnosis
  const f=rows[0], l=rows[rows.length-1];
  const trD=(l.traff-f.traff)/f.traff, cvD=(l.orders/l.traff)-(f.orders/f.traff);
  const aovD=((l.dAct/l.orders)-(f.dAct/f.orders))/(f.dAct/f.orders);
  const gmvD=(l.dAct-f.dAct)/f.dAct;
  const mid = rows.slice(0,-1);
  const midG = (mid[mid.length-1].dAct-mid[0].dAct)/mid[0].dAct;
  const peakTr = extremes(rows.map(r=>r.traff));
  document.getElementById("funnelDiag").innerHTML = [
    ins({t:"neg", open:true, h:"Traffic is falling, not growing", b:
      "<ul><li>Traffic peaked at <b>"+nf(rows[peakTr.hi].traff)+"</b> on "+rows[peakTr.hi].lbl+" and closed at <b>"+nf(l.traff)+"</b> on "+l.lbl+" — a <b>"+pctp((l.traff-rows[peakTr.hi].traff)/rows[peakTr.hi].traff,1)+"</b> move.</li>"+
      "<li>Across the period traffic moved <b>"+pctp(trD,1)+"</b> from "+f.lbl+" to "+l.lbl+".</li>"+
      "<li>Add-to-cart volume fell in step, from <b>"+nf(f.atc)+"</b> to <b>"+nf(l.atc)+"</b>.</li></ul>"}),
    ins({t:"warn", open:true, h:"Conversion dipped mid-week, then recovered", b:
      "<ul><li>Conversion ran <b>"+pct(f.orders/f.traff,2)+"</b> → <b>"+pct(rows[3]?rows[3].orders/rows[3].traff:0,2)+"</b> → <b>"+pct(l.orders/l.traff,2)+"</b>.</li>"+
      "<li>The trough coincides with the highest traffic and the highest marketing spend of the period, which points to lower-quality incremental traffic rather than a site problem — though the workbook holds no source or campaign detail to confirm that.</li>"+
      "<li>Cart-to-order held between <b>"+pct(Math.min(...rows.map(r=>r.orders/r.atc)),1)+"</b> and <b>"+pct(Math.max(...rows.map(r=>r.orders/r.atc)),1)+"</b>, so the weakness sits before the cart, not at checkout.</li></ul>"}),
    ins({t:"brand", h:"GMV movement is AOV-led, not traffic-led", b:
      "<ul><li>Traffic <b>"+pctp(trD,1)+"</b>, orders <b>"+pctp((l.orders-f.orders)/f.orders,1)+"</b>, AOV <b>"+pctp(aovD,0)+"</b> — but GMV <b>"+pctp(gmvD,0)+"</b>.</li>"+
      "<li>With traffic and orders both down, the entire GMV increase is explained by basket size.</li>"+
      "<li>Excluding the final day, GMV was <b>"+pctp(midG,1)+"</b> across "+mid.length+" days on falling conversion — the underlying trend was negative before the last-day spike.</li></ul>"}),
    ins({t:"warn", h:"Revenue per visitor tells the cleanest story", b:
      "<ul><li>Revenue per visitor: <b>"+moneyFull(f.dAct/f.traff)+"</b> on "+f.lbl+", bottoming at <b>"+moneyFull(Math.min(...mid.map(r=>r.dAct/r.traff)))+"</b>, then <b>"+moneyFull(l.dAct/l.traff)+"</b> on "+l.lbl+".</li>"+
      "<li>Period average is <b>"+moneyFull(A.rpv)+"</b>. Only the last day sits above it, so five of "+A.n+" days monetised traffic below the period average.</li></ul>"})
  ].join("");

  // returning vs new
  const seg=(n,tr,cv,ord,aov,sp,cpu,gmvI)=>"<tr><td>"+n+"</td><td>"+nf(tr)+"</td><td>"+pct(cv,2)+"</td><td>"+nf(ord)+"</td><td>"+pct(ord/A.orders,1)+"</td><td>"+moneyFull(aov)+"</td><td>"+moneyFull(gmvI)+"</td><td>"+moneyFull(sp)+"</td><td>"+moneyFull(cpu)+"</td></tr>";
  document.getElementById("tRbNb").innerHTML = tbl(
    ["Segment","Traffic","Conversion","Orders","Order share","AOV","Implied GMV","Spend","Cost per order"],
    seg("Returning",A.rbTr,A.rbConv,A.rbOrd,A.rbAov,A.rbSp,A.rbCpu,A.rbGmvI)+
    seg("New",A.nbTr,A.nbConv,A.nbOrd,A.nbAov,A.nbSp,A.nbCpu,A.nbGmvI),
    "<tr><td>Identified total</td><td>"+nf(A.trAttrib)+"</td><td>"+pct(A.orders/A.trAttrib,2)+"</td><td>"+nf(A.orders)+"</td><td>100.0%</td><td>"+moneyFull(A.aov)+"</td><td>"+moneyFull(A.rbGmvI+A.nbGmvI)+"</td><td>"+moneyFull(A.rbSp+A.nbSp)+"</td><td>"+moneyFull((A.rbSp+A.nbSp)/A.orders)+"</td></tr>");
  document.getElementById("rbnbNote").innerHTML =
    "Returning visitors convert at <b>"+pct(A.rbConv,2)+"</b> against <b>"+pct(A.nbConv,2)+"</b> for new — <b>"+(A.rbConv/A.nbConv).toFixed(2)+"x</b> better — but new buyers place <b>"+pct(A.nbOrd/A.orders,0)+"</b> of orders. "+
    "The site is acquisition-led on volume and repeat-led on efficiency.<br><br>"+
    "<b>Two source caveats.</b> Returning plus new traffic is <b>"+nf(A.trAttrib)+"</b> against a total of <b>"+nf(A.traff)+"</b>, leaving <b>"+nf(A.trGap)+"</b> visits ("+pct(A.trGap/A.traff,1)+") unattributed to a segment; segment conversion rates are therefore computed on identified traffic only. Implied GMV is segment AOV × segment orders and does not tie exactly to total GMV, so it is directional. "+
    "Separately, recorded new-buyer cost per order (<b>"+moneyFull(A.nbCpu)+"</b>) is <i>below</i> returning-buyer cost per order (<b>"+moneyFull(A.rbCpu)+"</b>), which is the reverse of the usual pattern and worth confirming against the spend-tagging logic before it is acted on.";

  mk("cRbNb", {type:"bar", data:{labels:["Traffic share","Order share","Conversion (indexed)","AOV (indexed)"], datasets:[
    {label:"Returning", data:[A.rbTr/A.trAttrib*100, A.rbOrd/A.orders*100, A.rbConv/(A.rbConv+A.nbConv)*100, A.rbAov/(A.rbAov+A.nbAov)*100], backgroundColor:"#12496E", borderRadius:3},
    {label:"New", data:[A.nbTr/A.trAttrib*100, A.nbOrd/A.orders*100, A.nbConv/(A.rbConv+A.nbConv)*100, A.nbAov/(A.rbAov+A.nbAov)*100], backgroundColor:"#A9761B", borderRadius:3}
  ]}, options:{indexAxis:"y", scales:{x:{stacked:true, grid:GRID, max:100, ticks:{callback:v=>v+"%"}}, y:{stacked:true, grid:{display:false}}},
    plugins:{tooltip:{callbacks:{label:c=>c.dataset.label+": "+c.parsed.x.toFixed(1)+"% of the pair"}}}}});

  // profitability
  const mx = extremes(rows.map(r=>r.markPct));
  document.getElementById("profitKpis").innerHTML = [
    kpi({acc:"brand", l:"Net revenue", v:money(A.netRev), f:pct(A.nrRatio,1)+" of website GMV"}),
    kpi({acc:"warn", l:"Marketing spend ÷ GMV", v:pct(A.spOverGmv,1), f:moneyFull(A.markSp)+" of media on "+moneyFull(A.gmv)+" GMV"}),
    kpi({acc:"warn", l:"Marketing spend ÷ net revenue", v:pct(A.spOverNr,1), f:"Nearly half of net revenue goes to media"}),
    kpi({acc:"neg", l:"Cost per order", v:moneyFull(A.cpu), f:"Range "+moneyFull(Math.min(...rows.map(r=>r.markSp/r.orders)))+" to "+moneyFull(Math.max(...rows.map(r=>r.markSp/r.orders)))}),
    kpi({acc:"neg", l:"Highest marketing intensity", v:rows[mx.hi].lbl, f:pct(rows[mx.hi].markPct,1)+" of GMV · "+moneyFull(rows[mx.hi].markSp)}),
    kpi({acc:"pos", l:"Lowest marketing intensity", v:rows[mx.lo].lbl, f:pct(rows[mx.lo].markPct,1)+" of GMV · "+moneyFull(rows[mx.lo].markSp)}),
    kpi({acc:"pos", l:"Strongest profitability day", v:rows[extremes(rows.map(r=>r.pm)).hi].lbl, f:"PM% "+pct(rows[extremes(rows.map(r=>r.pm)).hi].pm,2)+" as reported"}),
    kpi({acc:"neg", l:"Weakest profitability day", v:rows[extremes(rows.map(r=>r.pm)).lo].lbl, f:"PM% "+pct(rows[extremes(rows.map(r=>r.pm)).lo].pm,2)+" as reported"})
  ].join("");

  mk("cProfit", {type:"bar", data:{labels:L(), datasets:[
    {label:"Marketing spend", data:rows.map(r=>r.markSp), backgroundColor:"#9CC3DD", borderRadius:3, yAxisID:"y", order:3},
    {label:"Website GMV", data:rows.map(r=>r.dAct), backgroundColor:"#12496E", borderRadius:3, yAxisID:"y", order:2},
    {type:"line", label:"Marketing % of GMV", data:rows.map(r=>r.markPct*100), yAxisID:"y1", borderColor:"#B3261E", backgroundColor:"#B3261E", borderWidth:2.5, pointRadius:4, tension:.3, order:1},
    {type:"line", label:"Cost per order", data:rows.map(r=>r.markSp/r.orders), yAxisID:"y2", borderColor:"#A9761B", backgroundColor:"#A9761B", borderWidth:2, borderDash:[5,4], pointRadius:3.5, tension:.3, order:0}
  ]}, options:{scales:{
      y:{grid:GRID, ticks:{callback:v=>money(v)}},
      y1:{position:"right", grid:{display:false}, ticks:{callback:v=>v.toFixed(0)+"%"}, max:80},
      y2:{display:false},
      x:{grid:{display:false}}},
    plugins:{tooltip:{callbacks:{label:c=>{
      if(c.dataset.yAxisID==="y1") return c.dataset.label+": "+c.parsed.y.toFixed(1)+"%";
      return c.dataset.label+": "+moneyFull(c.parsed.y);}}}}}});

  const pex = {cpu:extremes(rows.map(r=>r.markSp/r.orders)), mk:extremes(rows.map(r=>r.markPct)),
               nr:extremes(rows.map(r=>r.netRev/r.dAct)), pm:extremes(rows.map(r=>r.pm))};
  document.getElementById("tProfit").innerHTML = tbl(
    ["Date","GMV","Net revenue","Net rev ÷ GMV","Marketing spend","Marketing % of GMV","Spend ÷ net rev","Cost per order","PM% (reported)","Promo% (reported)"],
    rows.map((r,i)=>"<tr><td>"+r.lbl+"</td><td>"+moneyFull(r.dAct)+"</td><td>"+moneyFull(r.netRev)+"</td>"+
      hcell(r.netRev/r.dAct,i,pex.nr,v=>pct(v,1))+
      "<td>"+moneyFull(r.markSp)+"</td>"+
      hcell(r.markPct,i,pex.mk,v=>pct(v,1),true)+
      "<td>"+pct(r.markSp/r.netRev,1)+"</td>"+
      hcell(r.markSp/r.orders,i,pex.cpu,v=>moneyFull(v),true)+
      hcell(r.pm,i,pex.pm,v=>pct(v,2))+
      "<td>"+pct(r.promo,2)+"</td></tr>").join(""),
    "<tr><td>Total</td><td>"+moneyFull(A.gmv)+"</td><td>"+moneyFull(A.netRev)+"</td><td>"+pct(A.nrRatio,1)+"</td><td>"+moneyFull(A.markSp)+"</td><td>"+pct(A.spOverGmv,1)+"</td><td>"+pct(A.spOverNr,1)+"</td><td>"+moneyFull(A.cpu)+"</td><td>—</td><td>—</td></tr>");
}

/* ==========================================================================
   TAB 4 — CHANNEL PERFORMANCE
   ========================================================================== */
function renderChannel(){
  document.getElementById("chanFilter").innerHTML =
    '<span class="muted" style="font-size:12px">Channels</span>'+
    CH.map(c=>'<button class="chip" data-ch="'+c.k+'" aria-pressed="'+(chanOn[c.k]?"true":"false")+'">'+c.n+'</button>').join("");
  document.querySelectorAll("[data-ch]").forEach(b=>b.onclick=()=>{chanOn[b.dataset.ch]=chanOn[b.dataset.ch]?0:1; renderChannel();});

  const on = CH.filter(c=>chanOn[c.k]);
  const ranked = [...on].sort((a,b)=>b.gmv(A)-a.gmv(A));
  const body = ranked.map(c=>{
    const g=c.gmv(A), s=c.sp(A), first=c.d(rows[0]), last=c.d(rows[rows.length-1]);
    const gr = first ? (last-first)/first : null;
    const bl = c.roas(A);
    return "<tr><td>"+c.n+(c.inTotal?"":' <span class="badge b-brand">in website</span>')+"</td>"+
      "<td>"+moneyFull(g)+"</td>"+
      "<td>"+(c.inTotal?pct(g/A.tAct,1):'<span class="muted">n/a</span>')+"</td>"+
      "<td>"+(s===null||s===0?'<span class="muted">'+(s===0?"₹0 recorded":"Not recorded")+'</span>':moneyFull(s))+"</td>"+
      "<td>"+(s?pct(s/g,1):'<span class="muted">—</span>')+"</td>"+
      "<td>"+(bl===null||!isFinite(bl)?'<span class="muted">—</span>':rx(bl))+"</td>"+
      "<td class='"+(gr===null?"":sgn(gr))+"'>"+(gr===null?"—":pctp(gr,1))+"</td></tr>";
  }).join("");
  const inTot = on.filter(c=>c.inTotal);
  const tg = sum(inTot,c=>c.gmv(A)), ts = sum(inTot,c=>c.sp(A)||0);
  const foot = inTot.length
    ? "<tr><td>Selected channels (excl. BIK)</td><td>"+moneyFull(tg)+"</td><td>"+pct(tg/A.tAct,1)+"</td><td>"+moneyFull(ts)+"</td><td>"+(ts?pct(ts/tg,1):"—")+"</td><td>"+(ts?rx(tg/ts):"—")+"</td><td>—</td></tr>"
    : "";
  document.getElementById("tChan").innerHTML = tbl(
    ["Channel","GMV","Share of total GMV","Recorded spend","Spend ÷ GMV","Blended ROAS","First → last day"],
    body || '<tr><td colspan="7" class="muted" style="text-align:left;padding:18px 10px">No channels selected. Pick at least one channel above to see the matrix.</td></tr>',
    foot);

  document.getElementById("chanNote").innerHTML =
    "Ranked by GMV contribution. Blended ROAS is channel GMV ÷ recorded spend; it includes organic and repeat demand and so runs above platform-attributed ROAS. "+
    "BIK GMV sits <b>inside</b> website GMV — the column header in the source says so — and is shown for visibility only, excluded from the contribution total.<br><br>"+
    "<b>Two spend definitions.</b> Website spend here is the workbook's Website Ads Spends line (<b>"+moneyFull(A.webAds)+"</b>), which is the site's combined media total. The Spend &amp; ROAS tab builds spend up from individual platforms (Meta <b>"+moneyFull(A.metaSp)+"</b> + BIK <b>"+moneyFull(A.bikSp)+"</b> = <b>"+moneyFull(A.metaSp+A.bikSp)+"</b>), which is <b>"+moneyFull(Math.abs(A.metaSp+A.bikSp-A.webAds))+"</b> higher. "+
    "The difference traces to BIK spend appearing in the Website Ads Spends column on the wrong row in the source. Both views are shown rather than one being silently picked. "+
    "BlinkIT ROAS uses only the "+A.blkSpDays+" days with recorded spend.";

  mk("cChanStack", {type:"bar", data:{labels:L(), datasets:on.filter(c=>c.inTotal).map(c=>({
    label:c.n, data:rows.map(c.d), backgroundColor:c.c, borderRadius:2}))},
    options:{scales:{x:{stacked:true, grid:{display:false}}, y:{stacked:true, grid:GRID, ticks:{callback:v=>money(v)}}},
      plugins:{tooltip:{callbacks:{label:c=>c.dataset.label+": "+moneyFull(c.parsed.y),
        footer:it=>"Day total: "+moneyFull(it.reduce((t,i)=>t+i.parsed.y,0))}}}}});

  // rankings
  const gmvR = [...CH].filter(c=>c.inTotal).sort((a,b)=>b.gmv(A)-a.gmv(A));
  const growR = [...CH].filter(c=>c.inTotal).map(c=>({c, d:c.d(rows[rows.length-1])-c.d(rows[0])})).sort((a,b)=>b.d-a.d);
  const roasR = [...CH].map(c=>({c, v:c.roas(A)})).filter(o=>o.v!==null && isFinite(o.v)).sort((a,b)=>b.v-a.v);
  const spR  = [...CH].map(c=>({c, v:c.sp(A)})).filter(o=>o.v!==null && o.v>0).sort((a,b)=>b.v-a.v);
  const lst = (t,q,items) => '<div style="margin-bottom:16px"><div style="font-size:13px;font-weight:600">'+t+'</div><div style="font-size:12px;color:var(--ink-3);margin-bottom:8px">'+q+'</div>'+
    items.map((s,i)=>'<div style="display:flex;justify-content:space-between;gap:10px;padding:5px 0;border-bottom:1px solid var(--line-2);font-size:12.5px"><span><span class="muted">'+(i+1)+'</span> &nbsp;'+s[0]+'</span><b>'+s[1]+'</b></div>').join("")+'</div>';
  document.getElementById("rankBox").innerHTML =
    lst("By GMV contribution","The ranking that should drive attention.", gmvR.map(c=>[c.n, moneyFull(c.gmv(A))+" · "+pct(c.gmv(A)/A.tAct,1)])) +
    lst("By growth contribution","Rupee change from "+rows[0].lbl+" to "+rows[rows.length-1].lbl+".", growR.map(o=>[o.c.n, (o.d>=0?"+":"−")+moneyFull(Math.abs(o.d))])) +
    lst("By blended ROAS","GMV ÷ recorded spend. Read alongside size, not instead of it.", roasR.map(o=>[o.c.n, rx(o.v)])) +
    lst("By recorded spend","Where the budget actually sits.", spR.map(o=>[o.c.n, moneyFull(o.v)+" · "+pct(o.v/A.spend,1)+" of media"])) +
    '<div class="callout brand" style="font-size:12.5px">BIK shows the highest blended ROAS of any line at '+rx(A.bikGmv/A.bikSp)+', on '+moneyFull(A.bikSp)+' of spend — <b>'+pct(A.bikSp/A.spend,1)+'</b> of total media. Amazon, at '+rx(A.amzTot/A.amzSp)+', carries '+moneyFull(A.amzSp)+'. Ranking on ROAS alone would put a channel with '+pct(A.bikGmv/A.tAct,1)+' of GMV above one with '+pct(A.amzTot/A.tAct,1)+'.</div>';

  // Amazon
  const aFirst=rows[0], aLast=rows[rows.length-1];
  const aTrend = (aLast.amzTot-aFirst.amzTot)/aFirst.amzTot;
  const aEx = extremes(rows.map(r=>r.amzTot));
  document.getElementById("amzKpis").innerHTML = [
    kpi({acc:"brand", l:"Amazon total GMV", v:money(A.amzTot), f:pct(A.amzTot/A.tAct,1)+" of total business"}),
    kpi({acc:"brand", l:"Amazon retail vs B2B", v:money(A.amzGmv)+" / "+money(A.amzB2b), f:"B2B is "+pct(A.amzB2b/A.amzTot,1)+" of Amazon GMV"}),

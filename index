/* ---------------- helpers ---------------- */
function kpi(o){
  return '<div class="kpi acc-'+(o.acc||"brand")+'"><div class="k-l">'+o.l+'</div><div class="k-v '+(o.vc||"")+'">'+o.v+'</div><div class="k-f '+(o.fc||"")+'">'+(o.f||"")+'</div></div>';
}
function ins(o){
  return '<details class="ins t-'+o.t+'"'+(o.open?" open":"")+'><summary>'+o.h+'<span class="chev">›</span></summary><div class="body">'+o.b+'</div></details>';
}
function tbl(head, body, foot){
  return "<thead><tr>"+head.map(h=>"<th>"+h+"</th>").join("")+"</tr></thead><tbody>"+body+"</tbody>"+(foot?"<tfoot>"+foot+"</tfoot>":"");
}
function extremes(vals){                 // returns {hi:idx, lo:idx} ignoring nulls
  let hi=-1, lo=-1;
  vals.forEach((v,i)=>{ if(v===null||v===undefined||isNaN(v)) return;
    if(hi<0||v>vals[hi]) hi=i; if(lo<0||v<vals[lo]) lo=i; });
  return {hi,lo};
}
function hcell(v, i, ex, fmt, invert){
  if(v===null||v===undefined) return '<td class="cell-na">Not Updated</td>';
  let c=""; const hi = invert?ex.lo:ex.hi, lo = invert?ex.hi:ex.lo;
  if(i===hi) c=" cell-hi"; else if(i===lo) c=" cell-lo";
  return '<td class="'+c.trim()+'">'+fmt(v)+"</td>";
}

